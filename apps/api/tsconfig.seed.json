{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist-seed",
    "declaration": false,
    "sourceMap": false,
    "incremental": false
  },
  "include": [
    "prisma/seed-render-demo.ts",
    "prisma/seed-render-demo.policy.ts",
    "prisma/seed-render-internal.ts",
    "prisma/seed-render-internal.policy.ts",
    "prisma/seed-catalog.fixtures.ts",
    "prisma/seed-compose-coupons.policy.ts",
    "src/generated/prisma/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "dist-seed", "**/*.spec.ts"]
}
